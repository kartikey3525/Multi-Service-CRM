APP_BASE_URL=http://localhost
APP_DOMAIN=localhost
MONGODB_URI=mongodb://db:27017/franchise_crm?replicaSet=rs0
# Production migrations require a separate MongoDB operator identity; leave empty for local Compose.
MONGODB_MIGRATION_URI=
REDIS_URL=redis://redis:6379
S3_ENDPOINT=http://storage:9000
S3_ACCESS_KEY=local-development-only
S3_SECRET_KEY=local-development-only
S3_REGION=us-east-1
SESSION_SECRET=local-development-session-secret-change-before-deploy
# Local-only example; generate a different value with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SMTP_URL=
MAIL_FROM=no-reply@example.test
ADMIN_BOOTSTRAP_EMAIL=admin@example.test
ADMIN_BOOTSTRAP_PASSWORD=change-me-before-use
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_IP_MAX_REQUESTS=60
LOGIN_RATE_LIMIT_ACCOUNT_MAX_REQUESTS=10
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=900
PASSWORD_RESET_RATE_LIMIT_IP_MAX_REQUESTS=30
PASSWORD_RESET_RATE_LIMIT_ACCOUNT_MAX_REQUESTS=3
ADMIN_SESSION_TTL_SECONDS=14400
PARTNER_SESSION_TTL_SECONDS=43200
TZ=Asia/Kolkata
LOG_LEVEL=info
MONGODB_DATABASE=franchise_crm
NODE_ENV=development
