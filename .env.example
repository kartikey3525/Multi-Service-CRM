APP_BASE_URL=http://localhost
APP_DOMAIN=localhost
MONGODB_URI=mongodb://crm_app:local-app-password-change@db:27017/crm?authSource=admin&replicaSet=rs0
# Used only by the one-shot migrator service, never by API or worker runtime containers.
MONGODB_MIGRATE_URI=mongodb://crm_migrator:local-migrator-password-change@db:27017/crm?authSource=admin&replicaSet=rs0
MONGODB_IMMUTABLE_DATABASE=crm_immutable
MONGODB_LOCAL_REPLICA_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
MONGODB_LOCAL_ROOT_USERNAME=local_root
MONGODB_LOCAL_ROOT_PASSWORD=local-root-password-change
MONGODB_LOCAL_APP_PASSWORD=local-app-password-change
MONGODB_LOCAL_MIGRATOR_PASSWORD=local-migrator-password-change
MONGODB_TEST_URI=mongodb://local_root:local-root-password-change@db:27017/crm_test?authSource=admin&replicaSet=rs0
MONGODB_LOCAL_VIEWER_PASSWORD=local-viewer-password-change
MONGODB_LOCAL_VIEWER_URI=mongodb://crm_viewer:local-viewer-password-change@db:27017/crm?authSource=admin&replicaSet=rs0
MONGODB_DATABASE=crm
MONGODB_LEGACY_DATABASE=franchise_crm
REDIS_URL=redis://redis:6379
S3_ENDPOINT=http://storage:9000
S3_ACCESS_KEY=local-development-only
S3_SECRET_KEY=local-development-only
S3_REGION=us-east-1
S3_BUCKET=crm-private-files
SESSION_SECRET=local-development-session-secret-change-before-deploy
# Local-only example; generate a different value with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SMTP_URL=
MAIL_FROM=no-reply@example.test
ADMIN_BOOTSTRAP_EMAIL=admin@example.test
ADMIN_BOOTSTRAP_PASSWORD=change-me-before-use
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_IP_MAX_REQUESTS=60
LOGIN_RATE_LIMIT_ACCOUNT_MAX_REQUESTS=10
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=900
PASSWORD_RESET_RATE_LIMIT_IP_MAX_REQUESTS=30
PASSWORD_RESET_RATE_LIMIT_ACCOUNT_MAX_REQUESTS=3
ADMIN_SESSION_TTL_SECONDS=14400
PARTNER_SESSION_TTL_SECONDS=43200
TZ=Asia/Kolkata
LOG_LEVEL=info
NODE_ENV=development
