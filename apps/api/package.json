{
  "name": "@franchise-crm/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "worker:dev": "tsx watch src/worker.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "test:integration": "node --import tsx --test test/*.integration.test.ts",
    "migrate": "migrate-mongo up --file migrate-mongo-config.js",
    "seed": "tsx src/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@franchise-crm/shared": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "ioredis": "^6.0.0",
    "migrate-mongo": "^14.0.7",
    "mongoose": "^9.0.0",
    "nodemailer": "^10.6.1",
    "otplib": "^12.0.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.1.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
